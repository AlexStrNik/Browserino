    "browsers.list.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag and drop to reorder. Press record to assign a shortcut. Click on eye to hide unwanted browsers from prompt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте для изменения порядка. Нажмите «Назначить» для выбора клавиши. Значок глаза скрывает браузер из списка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Mit „Zuweisen“ eine Taste festlegen. Das Augensymbol blendet Browser aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. Cliquez sur « Assigner » pour choisir une touche. L’icône œil masque un navigateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Pulsa «Asignar» para elegir una tecla. El icono del ojo oculta un navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Clique em «Atribuir» para escolher uma tecla. O ícone de olho oculta um navegador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Premi «Assegna» per scegliere un tasto. L’icona dell’occhio nasconde un browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。「割り当て」でキーを設定し、目のアイコンでブラウザを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 바꾸세요. «지정»을 눌러 키를 설정하고 눈 아이콘으로 브라우저를 숨기세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整顺序。点击“分配”设置快捷键，点击眼睛图标隐藏浏览器。"
          }
        }
      }
    },
